{
  "name": "@openhand/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "OpenHand Web 通用消息平台前端 (Vite + Preact + TypeScript + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm check:runtime && vite build && node scripts/stamp-service-worker.mjs ../../assets/web && node scripts/validate-bundle.mjs ../../assets/web",
    "check:runtime": "node scripts/check-runtime.mjs && node scripts/check-interactions.mjs && node scripts/check-voice-conversation.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
