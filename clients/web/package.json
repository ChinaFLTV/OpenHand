{
  "name": "@openhand/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "OpenHand Web 通用消息平台前端 (Vite + Preact + TypeScript + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/validate-bundle.mjs ../../assets/web",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "katex": "^0.17.0",
    "mermaid": "^11.16.1",
    "preact": "^10.24.3",
    "preact-iso": "^2.12.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
