{
  "name": "@openhand/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenHand Web 通用消息平台前端 (Vite + Preact + TypeScript + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/validate-bundle.mjs ../../assets/web",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "^10.24.3",
    "preact-iso": "^2.12.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.9.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
